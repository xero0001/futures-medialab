# Pooled runtime URL. Vercel Marketplace injects this automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futures_medialab?schema=public"

# Direct or unpooled URL used by Prisma migrations when available.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/futures_medialab?schema=public"

# Generate a separate random secret for each environment; never commit real values.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Private agency/studio proof and contract uploads. Server-only; never NEXT_PUBLIC_.
# Provision a private Blob store and pull its Development credentials.
BLOB_READ_WRITE_TOKEN=""
