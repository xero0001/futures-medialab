{
  "name": "@futures-medialab/database",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/client.ts",
    "./requests": "./src/requests.ts",
    "./request-workflow": "./src/request-workflow.ts",
    "./request-http": "./src/request-http.ts",
    "./proposal-types": "./src/proposal-types.ts",
    "./proposal-validation": "./src/proposal-validation.ts",
    "./proposals": "./src/proposals.ts",
    "./proposal-http": "./src/proposal-http.ts",
    "./production-types": "./src/production-types.ts",
    "./production-validation": "./src/production-validation.ts",
    "./production": "./src/production.ts",
    "./production-http": "./src/production-http.ts",
    "./reporting-types": "./src/reporting-types.ts",
    "./reporting-validation": "./src/reporting-validation.ts",
    "./reporting": "./src/reporting.ts",
    "./reporting-http": "./src/reporting-http.ts",
    "./settlement-types": "./src/settlement-types.ts",
    "./settlement-validation": "./src/settlement-validation.ts",
    "./settlement": "./src/settlement.ts",
    "./settlement-http": "./src/settlement-http.ts"
  },
  "scripts": {
    "build": "prisma generate && tsup src/client.ts --format esm --dts",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.8",
    "@vercel/blob": "^2.8.2",
    "dotenv": "18.0.0",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@futures-medialab/eslint-config": "workspace:*",
    "@futures-medialab/typescript-config": "workspace:*",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.2",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
