generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  KO
  ZH
}

enum OrganizationType {
  PLATFORM
  BRAND
  AGENCY
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgencyDocumentKind {
  BUSINESS_REGISTRATION
  CONTRACT
}

enum AgencyDocumentState {
  PENDING
  UPLOADED
  REJECTED
}

enum CampaignType {
  OPEN_BIDDING
  MANAGED
}

enum CampaignStatus {
  DRAFT
  REVIEW
  RECRUITING
  IN_PROGRESS
  VERIFYING
  SETTLING
  COMPLETED
  CANCELED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
  VERIFIED
}

enum SettlementStatus {
  PENDING
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum Currency {
  KRW
  USD
  CNY
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUPERSEDED
}

enum ProposalItemStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ProposalDecisionKind {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

model User {
  ownedInternalCreators InternalCreator[]
  internalRateUpdates InternalCreatorRateCard[]
  internalCreatorMutations InternalCreatorMutation[]
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  name                  String?
  image                 String?
  locale                Locale                 @default(EN)
  sessions              Session[]
  accounts              Account[]
  memberships           OrganizationMember[]
  createdCampaigns      Campaign[]             @relation("CampaignCreator")
  submittedApplications CampaignApplication[]  @relation("ApplicationSubmitter")
  askedQuestions        CampaignQuestion[]     @relation("QuestionAuthor")
  auditLogs             AuditLog[]
  directorySearches     DirectorySearch[]
  shortLinks            ShortLink[]
  workspaceToolRequests WorkspaceToolRequest[]
  assignedRequests      WorkspaceToolRequest[] @relation("RequestAssignee")
  requestMessages       RequestMessage[]
  requestAttachments    RequestAttachment[]
  agencyDocuments       AgencyDocument[]
  createdProposals      CampaignProposal[] @relation("ProposalCreator")
  publishedProposals    CampaignProposal[] @relation("ProposalPublisher")
  proposalDecisions     ProposalDecision[]
  productionAssignments ProductionItem[] @relation("ProductionAssigner")
  productionSubmissions ProductionSubmission[] @relation("ProductionSubmitter")
  reportingSubmissions ReportingSubmission[] @relation("ReportingSubmitter")
  reviewedReporting ReportingSubmission[] @relation("ReportingReviewer")
  reviewedProduction ProductionSubmission[] @relation("ProductionReviewer")
  decidedProduction ProductionSubmission[] @relation("ProductionBrandReviewer")
  productionMutations ProductionMutation[]
  reportingMutations ReportingMutation[]
  campaignCompletions CampaignCompletion[]
  issuedBrandInvoices BrandInvoice[] @relation("BrandInvoiceIssuer")
  issuedInvoiceVersions BrandInvoiceVersion[] @relation("BrandInvoiceVersionIssuer")
  recordedBrandPayments BrandInvoice[] @relation("BrandInvoicePaymentRecorder")
  issuedAgencyPayouts AgencyPayout[] @relation("AgencyPayoutIssuer")
  recordedAgencyPayments AgencyPayout[] @relation("AgencyPayoutPaymentRecorder")
  officialSettlementMutations SettlementMutation[]
  proposalMutations     ProposalMutation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}

model Organization {
  internalCreators InternalCreator[]
  id                    String                 @id @default(cuid())
  type                  OrganizationType
  status                OrganizationStatus     @default(PENDING)
  name                  String
  slug                  String                 @unique
  countryCode           String?                @db.VarChar(2)
  businessNumber        String?
  websiteUrl            String?
  metadata              Json                   @default("{}")
  members               OrganizationMember[]
  campaigns             Campaign[]             @relation("BrandCampaigns")
  applications          CampaignApplication[]  @relation("AgencyApplications")
  creators              CreatorProfile[]
  questions             CampaignQuestion[]
  settlements           Settlement[]
  creatorCollections    CreatorCollection[]
  directorySearches     DirectorySearch[]
  shortLinks            ShortLink[]
  workspaceToolRequests WorkspaceToolRequest[]
  agencyDocuments       AgencyDocument[]
  productionItems ProductionItem[]
  suppliedProposalItems ProposalItem[]
  brandInvoices BrandInvoice[]
  agencyPayouts AgencyPayout[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([type, status])
}

model OrganizationMember {
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@id([userId, organizationId])
  @@index([organizationId, role])
}

// Private onboarding documents. Blob URLs and upload tokens are never persisted.
model AgencyDocument {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  kind           AgencyDocumentKind
  state          AgencyDocumentState @default(PENDING)
  pathname       String              @unique
  fileName       String
  contentType    String
  size           Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, kind, state])
  @@index([organizationId, createdAt])
  @@index([userId])
}

model Campaign {
  id                  String                 @id @default(cuid())
  brandOrganizationId String
  createdById         String
  type                CampaignType           @default(OPEN_BIDDING)
  status              CampaignStatus         @default(DRAFT)
  title               String
  privateTitle        String?
  summary             String                 @default("") @db.Text
  briefUrl            String?
  coverImageUrl       String?
  platforms           String[]               @default([])
  regions             String[]               @default([])
  categories          String[]               @default([])
  followerMin         Int?
  followerMax         Int?
  budgetAmount        Decimal?               @db.Decimal(18, 2)
  currency            Currency               @default(USD)
  requirements        Json                   @default("{}")
  settlementPolicy    Json                   @default("{}")
  managedRequest      Json                   @default("{}")
  applicationDeadline DateTime?
  contentDeadline     DateTime?
  publishedAt         DateTime?
  brandOrganization   Organization           @relation("BrandCampaigns", fields: [brandOrganizationId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  applications        CampaignApplication[]
  questions           CampaignQuestion[]
  requests            WorkspaceToolRequest[]
  proposals           CampaignProposal[]
  productionItems ProductionItem[]
  productionMutations ProductionMutation[]
  reportingItems ReportingItem[]
  reportingMutations ReportingMutation[]
  completion CampaignCompletion?
  brandInvoice BrandInvoice?
  agencyPayouts AgencyPayout[]
  officialSettlementMutations SettlementMutation[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status, applicationDeadline])
  @@index([brandOrganizationId, status])
  @@index([type, status])
}

// Opt-in published directory records, separate from private agency rosters.
model CreatorDirectoryEntry {
  id          String                  @id @default(cuid())
  platform    String
  isDemo      Boolean                 @default(false)
  isPublished Boolean                 @default(false)
  payload     Json
  collections CreatorCollectionItem[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([platform, isPublished, isDemo])
}

model CreatorCollection {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          CreatorCollectionItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, name])
}

model CreatorCollectionItem {
  collectionId String
  entryId      String
  collection   CreatorCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entry        CreatorDirectoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())

  @@id([collectionId, entryId])
  @@index([entryId])
}

model DirectorySearch {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  mode           String
  filtersJson    Json
  resultIdsJson  Json
  isDemo         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model ShortLink {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  code           String       @unique
  title          String
  targetUrl      String
  active         Boolean      @default(true)
  clickCount     Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model WorkspaceToolRequest {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  tool           String
  title          String
  inputJson      Json
  status         String              @default("REQUESTED")
  campaignId     String?
  assignedToId   String?
  priority       String              @default("NORMAL")
  dueAt          DateTime?
  version        Int                 @default(0)
  campaign       Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedTo     User?               @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       RequestMessage[]
  attachments    RequestAttachment[]
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, createdAt])
  @@index([status, updatedAt])
  @@index([assignedToId, dueAt])
  @@index([campaignId])
}

model RequestMessage {
  id          String               @id @default(cuid())
  requestId   String
  authorId    String
  body        String               @db.Text
  internal    Boolean              @default(false)
  authorRole  String
  request     WorkspaceToolRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments RequestAttachment[]
  createdAt   DateTime             @default(now())

  @@index([requestId, createdAt])
}

model RequestAttachment {
  id          String               @id @default(cuid())
  requestId   String
  uploaderId  String
  messageId   String?
  fileName    String
  contentType String
  size        Int
  pathname    String               @unique
  discardedAt DateTime?
  request     WorkspaceToolRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader    User                 @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  message     RequestMessage?      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  @@index([requestId, messageId])
}

model CreatorProfile {
  internalCatalogEntry InternalCreator?
  id                   String               @id @default(cuid())
  agencyOrganizationId String
  displayName          String
  countryCode          String?              @db.VarChar(2)
  primaryLanguage      Locale               @default(KO)
  channels             Json                 @default("[]")
  categories           String[]             @default([])
  internalNotes        String               @default("") @db.Text
  isActive             Boolean              @default(true)
  agencyOrganization   Organization         @relation(fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  applications         ApplicationCreator[]
  proposalItems        ProposalItem[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([agencyOrganizationId, isActive])
}

model CampaignApplication {
  id                   String               @id @default(cuid())
  campaignId           String
  agencyOrganizationId String
  submittedById        String
  status               ApplicationStatus    @default(SUBMITTED)
  proposal             String               @default("") @db.Text
  proposedAmount       Decimal?             @db.Decimal(18, 2)
  currency             Currency             @default(USD)
  rosterSnapshot       Json                 @default("[]")
  campaign             Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agencyOrganization   Organization         @relation("AgencyApplications", fields: [agencyOrganizationId], references: [id], onDelete: Restrict)
  submittedBy          User                 @relation("ApplicationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  creators             ApplicationCreator[]
  submissions          ContentSubmission[]
  settlement           Settlement?
  contract             CampaignContract?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([campaignId, agencyOrganizationId])
  @@index([agencyOrganizationId, status])
}

model CampaignContract {
  id            String              @id @default(cuid())
  applicationId String              @unique
  status        String              @default("DRAFT")
  referenceUrl  String?
  notes         String              @default("") @db.Text
  confirmedAt   DateTime?
  version       Int                 @default(0)
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ApplicationCreator {
  applicationId String
  creatorId     String
  deliverables  Json                @default("[]")
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creator       CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@id([applicationId, creatorId])
  @@index([creatorId])
}

model CampaignQuestion {
  id                   String       @id @default(cuid())
  campaignId           String
  agencyOrganizationId String
  askedById            String
  question             String       @db.Text
  answer               String?      @db.Text
  answeredAt           DateTime?
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agencyOrganization   Organization @relation(fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  askedBy              User         @relation("QuestionAuthor", fields: [askedById], references: [id], onDelete: Restrict)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([campaignId, createdAt])
  @@index([agencyOrganizationId, createdAt])
}

model ContentSubmission {
  id            String              @id @default(cuid())
  applicationId String
  version       Int                 @default(1)
  status        SubmissionStatus    @default(DRAFT)
  draftUrl      String?
  publishedUrl  String?
  reviewNotes   String              @default("") @db.Text
  metrics       Json                @default("{}")
  submittedAt   DateTime?
  reviewedAt    DateTime?
  verifiedAt    DateTime?
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([applicationId, version])
  @@index([status, submittedAt])
}

model Settlement {
  id                   String              @id @default(cuid())
  applicationId        String              @unique
  agencyOrganizationId String
  status               SettlementStatus    @default(PENDING)
  currency             Currency            @default(USD)
  grossAmount          Decimal             @db.Decimal(18, 2)
  platformFeeAmount    Decimal             @default(0) @db.Decimal(18, 2)
  withholdingAmount    Decimal             @default(0) @db.Decimal(18, 2)
  netAmount            Decimal             @db.Decimal(18, 2)
  exchangeRate         Decimal?            @db.Decimal(18, 8)
  transferReference    String?
  version              Int                 @default(0)
  adminReviewNotes     String              @default("") @db.Text
  requestedAt          DateTime?
  approvedAt           DateTime?
  paidAt               DateTime?
  application          CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  agencyOrganization   Organization        @relation(fields: [agencyOrganizationId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([agencyOrganizationId, status])
  @@index([status, requestedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  payload    Json     @default("{}")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// Only a published operator-curated snapshot can be serialized to a brand.
model CampaignProposal {
  id              String @id @default(cuid())
  campaignId      String
  version         Int
  revision        Int @default(0)
  status          ProposalStatus @default(DRAFT)
  title           String @default("")
  summary         String @default("") @db.Text
  changeSummary   String @default("") @db.Text
  terms           String @default("") @db.Text
  currency        Currency
  expiresAt       DateTime?
  publishedAt     DateTime?
  supersededAt    DateTime?
  createdById     String
  publishedById   String?
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy       User @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy     User? @relation("ProposalPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  items           ProposalItem[]
  decisions       ProposalDecision[]
  mutations       ProposalMutation[]
  completions CampaignCompletion[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, version])
  @@index([campaignId, status])
  @@index([status, expiresAt])
}

model ProposalItem {
  catalogCreatorId String?
  catalogRateVersion Int?
  catalogCreator InternalCreator? @relation(fields: [catalogCreatorId], references: [id], onDelete: Restrict)
  @@index([catalogCreatorId])
  id                       String @id @default(cuid())
  proposalId               String
  position                 Int
  creatorName              String @default("")
  platform                 String @default("")
  channelLabel             String @default("")
  channelUrl               String @default("")
  followers                Int?
  averageViews             Int?
  deliverables             String @default("") @db.Text
  quantity                 Int @default(0)
  unitAmount               Decimal? @db.Decimal(18, 2)
  scheduledAt              DateTime?
  rights                   String @default("") @db.Text
  status                   ProposalItemStatus @default(PENDING)
  // Private provenance and economics never belong to a brand DTO.
  creatorId                String?
  supplierOrganizationId   String?
  supplierCost             Decimal? @db.Decimal(18, 2)
  internalNotes            String @default("") @db.Text
  proposal                 CampaignProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  creator                  CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  productionItem           ProductionItem?
  supplierOrganization     Organization? @relation(fields: [supplierOrganizationId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([proposalId, position])
  @@index([creatorId])
}

model ProposalDecision {
  id              String @id @default(cuid())
  proposalId      String
  actorId         String
  decision        ProposalDecisionKind
  itemIds         String[]
  message         String @default("") @db.Text
  proposal        CampaignProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ProposalMutation {
  id              String @id @default(cuid())
  actorId         String
  clientRequestId String
  action          String
  payloadHash     String
  proposalId      String
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  proposal        CampaignProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([actorId, clientRequestId])
  @@index([proposalId])
}


// Raw agency submissions and operator-published brand snapshots are separate.
enum ProductionStatus {
  AWAITING_SUBMISSION
  ADMIN_REVIEW
  AGENCY_REVISION
  BRAND_REVIEW
  BRAND_REVISION
  APPROVED
}
enum ProductionBrandDecision {
  APPROVE
  REQUEST_CHANGES
}
model ProductionItem {
  id String @id @default(cuid())
  campaignId String
  proposalItemId String @unique
  supplierOrganizationId String?
  assignedById String?
  status ProductionStatus @default(AWAITING_SUBMISSION)
  revision Int @default(0)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposalItem ProposalItem @relation(fields: [proposalItemId], references: [id], onDelete: Cascade)
  supplierOrganization Organization? @relation(fields: [supplierOrganizationId], references: [id], onDelete: SetNull)
  assignedBy User? @relation("ProductionAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  submissions ProductionSubmission[]
  mutations ProductionMutation[]
  reportingItem ReportingItem?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campaignId, status])
  @@index([supplierOrganizationId, status])
}
model ProductionSubmission {
  id String @id @default(cuid())
  productionItemId String
  version Int
  status ProductionStatus @default(ADMIN_REVIEW)
  sourceTitle String
  sourceUrl String @db.Text
  sourceNote String @default("") @db.Text
  submittedById String
  submittedAt DateTime @default(now())
  adminReviewedById String?
  adminReviewedAt DateTime?
  agencyFeedback String @default("") @db.Text
  internalNote String @default("") @db.Text
  releasedTitle String?
  releasedUrl String? @db.Text
  releasedNote String? @db.Text
  releasedAt DateTime?
  brandDecision ProductionBrandDecision?
  brandMessage String @default("") @db.Text
  brandDecidedById String?
  brandDecidedAt DateTime?
  productionItem ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ProductionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  adminReviewedBy User? @relation("ProductionReviewer", fields: [adminReviewedById], references: [id], onDelete: Restrict)
  brandDecidedBy User? @relation("ProductionBrandReviewer", fields: [brandDecidedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productionItemId, version])
  @@index([productionItemId, releasedAt])
}
model ProductionMutation {
  id String @id @default(cuid())
  actorId String
  clientRequestId String
  action String
  payloadHash String
  campaignId String
  productionItemId String?
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productionItem ProductionItem? @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([actorId, clientRequestId])
  @@index([campaignId])
}


// Posted links and performance are reviewed before brand publication.
enum ReportingStatus {
  AWAITING_SUBMISSION
  ADMIN_REVIEW
  AGENCY_REVISION
  PUBLISHED
}
model ReportingItem {
  id String @id @default(cuid())
  campaignId String
  productionItemId String @unique
  status ReportingStatus @default(AWAITING_SUBMISSION)
  revision Int @default(0)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productionItem ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  submissions ReportingSubmission[]
  mutations ReportingMutation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campaignId, status])
}
model ReportingSubmission {
  id String @id @default(cuid())
  reportingItemId String
  version Int
  status ReportingStatus @default(ADMIN_REVIEW)
  sourceTitle String
  sourcePostUrl String @db.Text
  sourcePublishedAt DateTime
  sourceMetricsAsOf DateTime?
  sourceMetrics Json
  sourceEvidenceUrl String? @db.Text
  sourceNote String @default("") @db.Text
  submittedById String
  submittedAt DateTime @default(now())
  adminReviewedById String?
  adminReviewedAt DateTime?
  agencyFeedback String @default("") @db.Text
  internalNote String @default("") @db.Text
  releasedTitle String?
  releasedPostUrl String? @db.Text
  releasedPublishedAt DateTime?
  releasedMetricsAsOf DateTime?
  releasedMetrics Json?
  releasedEvidenceUrl String? @db.Text
  releasedNote String? @db.Text
  releasedAt DateTime?
  reportingItem ReportingItem @relation(fields: [reportingItemId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ReportingSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  adminReviewedBy User? @relation("ReportingReviewer", fields: [adminReviewedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([reportingItemId, version])
  @@index([reportingItemId, releasedAt])
}
model ReportingMutation {
  id String @id @default(cuid())
  actorId String
  clientRequestId String
  action String
  payloadHash String
  campaignId String
  reportingItemId String?
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reportingItem ReportingItem? @relation(fields: [reportingItemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([actorId, clientRequestId])
  @@index([campaignId])
}


// Official-proposal financial records are separate from legacy application Settlement.
enum OfficialSettlementStatus {
  DRAFT
  ISSUED
  PAID
}
model CampaignCompletion {
  id String @id @default(cuid())
  campaignId String @unique
  proposalId String
  proposalVersion Int
  proposalRevision Int
  readinessToken String
  evidenceSnapshot Json
  note String @db.Text
  completedById String
  completedAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposal CampaignProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  completedBy User @relation(fields: [completedById], references: [id], onDelete: Restrict)
  brandInvoice BrandInvoice?
  agencyPayouts AgencyPayout[]
  mutations SettlementMutation[]
}
model BrandInvoice {
  id String @id @default(cuid())
  campaignId String @unique
  completionId String @unique
  brandOrganizationId String
  status OfficialSettlementStatus @default(DRAFT)
  revision Int @default(0)
  documentVersion Int @default(0)
  versions BrandInvoiceVersion[]
  currency Currency
  amount Decimal @db.Decimal(18, 2)
  lineSnapshot Json
  title String
  note String @default("") @db.Text
  dueAt DateTime?
  documentUrl String? @db.Text
  internalNote String @default("") @db.Text
  issuedById String?
  issuedAt DateTime?
  paymentRecordedById String?
  paidAt DateTime?
  paidAmount Decimal? @db.Decimal(18, 2)
  externalPaymentReference String?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  completion CampaignCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  brandOrganization Organization @relation(fields: [brandOrganizationId], references: [id], onDelete: Restrict)
  issuedBy User? @relation("BrandInvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  paymentRecordedBy User? @relation("BrandInvoicePaymentRecorder", fields: [paymentRecordedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandOrganizationId, status])
}
model BrandInvoiceVersion {
  invoiceId String
  version Int
  title String
  note String @db.Text
  dueAt DateTime?
  documentUrl String? @db.Text
  currency Currency
  amount Decimal @db.Decimal(18, 2)
  lineSnapshot Json
  reason String? @db.Text
  issuedAt DateTime
  issuedById String?
  invoice BrandInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("BrandInvoiceVersionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  @@id([invoiceId, version])
  @@index([issuedAt])
}

model AgencyPayout {
  id String @id @default(cuid())
  campaignId String
  completionId String
  supplierOrganizationId String
  status OfficialSettlementStatus @default(DRAFT)
  revision Int @default(0)
  currency Currency
  amount Decimal @db.Decimal(18, 2)
  lineSnapshot Json
  supplierCostBasis String @default("ITEM_TOTAL")
  title String
  note String @default("") @db.Text
  dueAt DateTime?
  documentUrl String? @db.Text
  internalNote String @default("") @db.Text
  issuedById String?
  issuedAt DateTime?
  paymentRecordedById String?
  paidAt DateTime?
  paidAmount Decimal? @db.Decimal(18, 2)
  externalPaymentReference String?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  completion CampaignCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  supplierOrganization Organization @relation(fields: [supplierOrganizationId], references: [id], onDelete: Restrict)
  issuedBy User? @relation("AgencyPayoutIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  paymentRecordedBy User? @relation("AgencyPayoutPaymentRecorder", fields: [paymentRecordedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([completionId, supplierOrganizationId])
  @@index([campaignId])
  @@index([supplierOrganizationId, status])
}
model SettlementMutation {
  id String @id @default(cuid())
  actorId String
  clientRequestId String
  action String
  payloadHash String
  campaignId String
  completionId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  completion CampaignCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([actorId, clientRequestId])
  @@index([campaignId])
}

// Platform-only sourcing records. Public proposals expose independent snapshots.
model InternalCreator {
  id String @id @default(cuid())
  displayName String
  affiliation String
  partnerOrganizationId String?
  rosterCreatorId String? @unique
  ownerId String
  channels Json @default("[]")
  genres String[] @default([])
  languages String[] @default([])
  formats String[] @default([])
  audienceNotes String @default("") @db.Text
  availability String @default("UNKNOWN")
  availableFrom DateTime?
  availableThrough DateTime?
  availabilityNote String @default("") @db.Text
  acceptsChinaGames String @default("UNKNOWN")
  conflicts String @default("") @db.Text
  riskNotes String @default("") @db.Text
  availabilityCheckedAt DateTime?
  priceCheckedAt DateTime?
  isActive Boolean @default(true)
  revision Int @default(1)
  partnerOrganization Organization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: Restrict)
  rosterCreator CreatorProfile? @relation(fields: [rosterCreatorId], references: [id], onDelete: SetNull)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  rateCards InternalCreatorRateCard[]
  proposalItems ProposalItem[]
  mutations InternalCreatorMutation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, affiliation, updatedAt])
  @@index([ownerId])
  @@index([partnerOrganizationId])
}

model InternalCreatorRateCard {
  id String @id @default(cuid())
  creatorId String
  version Int
  rates Json
  reason String
  createdById String
  creator InternalCreator @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([creatorId, version])
}

model InternalCreatorMutation {
  id String @id @default(cuid())
  creatorId String
  actorId String
  requestId String
  payloadHash String
  creator InternalCreator @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([actorId, requestId])
}
